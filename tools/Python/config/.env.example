# Local DB path (do not commit real DB files)
SIG_DB_PATH=./data/sig_photos.db

# Optional cloud sync (leave empty to disable)
CLOUD_SYNC_ENDPOINT=
CLOUD_SYNC_API_KEY=

# Logging level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG

# Feature flags
ENABLE_HUMAN_REVIEW=false
