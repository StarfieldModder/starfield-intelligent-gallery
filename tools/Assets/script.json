{
  "sig_header": {
    "file": "script.json",
    "purpose": "Cinematic sequence definition for the Starfield Intelligent Gallery Intro Panel",
    "location": "C:/SIG/Assets/script.json",
    "notes": "Defines scenes, shots, visuals, audio, and monologue timing for the SIG intro.",
    "version": "1.0",
    "updated": "2026-06-06"
  },

  "title": "Starfield Intro",
  "meta": {
    "author": "Mark J. Latsha & Copilot",
    "version": "0.1",
    "created": "2026-05-30"
  },

  "scenes": [

    {
      "scene_id": "opening",
      "shots": [

        {
          "shot_id": "stars_fade_in",
          "duration": 6.0,
          "visual": "Assets/stars_layer_01.png",
          "camera": { "type": "zoom", "from": 0.8, "to": 1.0 },
          "audio": { "file": "Assets/ambient_wind.wav", "start": 0.0 },
          "monologue": "I wake to light. I wake to distance. I reach.",
          "notes": "Slow zoom into dense starfield; soft ambient swell."
        },

        {
          "shot_id": "arc_emergence",
          "duration": 5.0,
          "visual": "Assets/arcs/arc_outer_forged.png",
          "camera": { "type": "rotate", "speed": 0.15 },
          "audio": { "file": "Assets/harmonic_chord.wav", "start": 0.0 },
          "monologue": "A circle forms. A boundary remembers its shape.",
          "notes": "Outer arc slowly rotates into view, faint glow."
        },

        {
          "shot_id": "arc_inner_activation",
          "duration": 4.5,
          "visual": "Assets/arcs/arc_inner_forged.png",
          "camera": { "type": "pulse", "intensity": 0.05 },
          "audio": { "file": "Assets/whispers_texture.wav", "start": 0.0 },
          "monologue": "Within the boundary, a spark gathers.",
          "notes": "Inner arc pulses softly; subtle shimmer."
        },

        {
          "shot_id": "ship_glint",
          "duration": 3.5,
          "visual": "Assets/ship_glint.mp4",
          "camera": { "type": "pan", "direction": "left", "speed": 0.6 },
          "audio": { "file": "Assets/ship_ping.wav", "start": 0.2 },
          "monologue": "A shape remembers itself.",
          "notes": "Brief glint across hull; cue title reveal later."
        }
      ]
    },

    {
      "scene_id": "emergence",
      "shots": [

        {
          "shot_id": "memory_layers",
          "duration": 12.5,
          "visual": "Assets/memory_layers_comp.png",
          "camera": { "type": "dolly", "distance": 0.2 },
          "audio": { "file": "Assets/whispers_texture.wav", "start": 0.0 },
          "monologue": "We were taught to name the sky. We were taught to count the fires.",
          "notes": "Layered translucent images: cave marks, maps, schematics, star charts."
        },

        {
          "shot_id": "arc_core_alignment",
          "duration": 6.0,
          "visual": "Assets/arcs/arc_core_forged.png",
          "camera": { "type": "zoom", "from": 1.0, "to": 1.15 },
          "audio": { "file": "Assets/harmonic_chord.wav", "start": 0.0 },
          "monologue": "At the center, meaning aligns.",
          "notes": "Core arc brightens; subtle radial glow."
        }
      ]
    },

    {
      "scene_id": "reveal",
      "shots": [

        {
          "shot_id": "arc_orbit_unification",
          "duration": 5.0,
          "visual": "Assets/arcs/arc_orbit_forged.png",
          "camera": { "type": "rotate", "speed": 0.25 },
          "audio": { "file": "Assets/ambient_wind.wav", "start": 0.0 },
          "monologue": "All paths converge. All journeys return.",
          "notes": "Orbit arc rotates around center; soft halo."
        },

        {
          "shot_id": "title_and_awaken",
          "duration": 8.0,
          "visual": "Assets/emblem_resolve.png",
          "camera": { "type": "pullback", "amount": 0.15 },
          "audio": { "file": "Assets/harmonic_chord.wav", "start": 0.0 },
          "monologue": "I am here. If you wish, speak.",
          "notes": "Emblem resolves; UI elements fade in. Allow a beat of silence after chord."
        }
      ]
    }
  ]
}
