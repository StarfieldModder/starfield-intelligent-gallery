from __future__ import annotations

import sys
from pathlib import Path
from typing import Optional

# ── Ensure C:\SIG is on sys.path when run standalone ──────────────────────────
_SIG_ROOT = Path(__file__).resolve().parent
if str(_SIG_ROOT) not in sys.path:
    sys.path.insert(0, str(_SIG_ROOT))

from PySide6.QtCore    import Qt, Signal
from PySide6.QtGui     import QFont
from PySide6.QtWidgets import (
    QFrame, QHBoxLayout, QLabel, QPushButton,
    QSizePolicy, QTabWidget, QVBoxLayout, QWidget,
)

from sig_mission_controller_integration import create_mc_widget

# ── SIG dark palette ────────────────────────────────────────────────────────
_BG       = "#0d0f14"
_SURFACE  = "#14181f"
_BORDER   = "#1e2530"
_ACCENT   = "#00d4ff"
_GREEN    = "#00ff88"
_ORANGE   = "#ff8c00"
_PURPLE   = "#8855ff"
_TEXT     = "#c0ccd8"
_DIM      = "#5a6472"
_RED      = "#ff3333"

# ── Panel metadata ───────────────────────────────────────────────────────────
PANEL_LABELS = {
    3: ("ARTIFACTS",    "◈",  _ORANGE),
    4: ("COMPANIONS",   "◇",  _GREEN),
    5: ("COSMIC CHOICE","⟐",  _PURPLE),
}


# ─────────────────────────────────────────────────────────────────────────────
# TempleChildWidgetBeta
# ─────────────────────────────────────────────────────────────────────────────
class TempleChildWidgetBeta(QWidget):
    """
    Host widget for CarrierDeck panels 3 (ARTIFACTS), 4 (COMPANIONS),
    and 5 (COSMIC CHOICE).

    Panel 3 (ARTIFACTS) can optionally embed the Mission Controller as an
    "Image Vault" tab alongside your artefact collection panels.

    Parameters
    ----------
    panel_id : int
        3, 4, or 5 — selects which panel content to build.
    embed_mc_in_artifacts : bool
        When True and panel_id == 3, the Mission Controller is added as
        an "Image Vault" tab inside the ARTIFACTS QTabWidget.
    parent : QWidget | None
        PySide6 parent widget.

    Signals
    -------
    back_requested : no args
        Emitted when the user clicks the ← BACK navigation button.
    """

    back_requested: Signal = Signal()

    def __init__(
        self,
        panel_id: int = 3,
        embed_mc_in_artifacts: bool = True,
        parent: Optional[QWidget] = None,
    ) -> None:
        super().__init__(parent)
        self._panel_id = panel_id
        self._embed_mc = embed_mc_in_artifacts

        label, glyph, colour = PANEL_LABELS.get(panel_id, ("PANEL", "◈", _TEXT))
        self._label  = label
        self._glyph  = glyph
        self._colour = colour

        self.setWindowTitle(f"SIG — {label}")
        self.setStyleSheet(f"QWidget {{ background:{_BG}; color:{_TEXT}; }}")
        self._build_ui()

    # ── UI construction ──────────────────────────────────────────────────────
    def _build_ui(self) -> None:
        root = QVBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        # Header bar
        root.addWidget(self._build_header())

        # Coloured separator
        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine)
        sep.setStyleSheet(
            f"color:{self._colour}; border-top:2px solid {self._colour};"
        )
        sep.setFixedHeight(2)
        root.addWidget(sep)

        # Content area
        content = self._build_content()
        content.setSizePolicy(
            QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding
        )
        root.addWidget(content)

    def _build_header(self) -> QWidget:
        header = QWidget()
        header.setFixedHeight(48)
        header.setStyleSheet(
            f"background:{_SURFACE}; border-bottom:1px solid {_BORDER};"
        )

        h = QHBoxLayout(header)
        h.setContentsMargins(16, 0, 16, 0)

        # Back button
        back_btn = QPushButton("← BACK")
        back_btn.setFixedWidth(90)
        back_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        back_btn.setStyleSheet(
            f"QPushButton {{ background:transparent; border:1px solid {_BORDER}; "
            f"color:{_DIM}; font-size:11px; font-family:'Courier New'; "
            f"padding:4px 10px; border-radius:4px; }}"
            f"QPushButton:hover {{ border-color:{self._colour}; color:{self._colour}; }}"
        )
        back_btn.clicked.connect(self.back_requested.emit)
        h.addWidget(back_btn)

        glyph_lbl = QLabel(self._glyph)
        glyph_lbl.setFont(QFont("Courier New", 18))
        glyph_lbl.setStyleSheet(f"color:{self._colour}; margin-left:8px;")
        h.addWidget(glyph_lbl)

        title = QLabel(self._label)
        title.setFont(QFont("Courier New", 14, QFont.Weight.Bold))
        title.setStyleSheet(
            f"color:{self._colour}; letter-spacing:4px; margin-left:6px;"
        )
        h.addWidget(title)

        h.addStretch()

        ver = QLabel("v1.0.0  ·  SIG-MC")
        ver.setStyleSheet(
            f"color:{_DIM}; font-size:10px; font-family:'Courier New';"
        )
        h.addWidget(ver)

        return header

    def _build_content(self) -> QWidget:
        if self._panel_id == 3:
            return self._build_artifacts_panel()
        elif self._panel_id == 4:
            return self._build_companions_panel()
        else:
            return self._build_cosmic_choice_panel()

    # ── Panel 3: ARTIFACTS ───────────────────────────────────────────────────
    def _build_artifacts_panel(self) -> QTabWidget:
        tabs = QTabWidget()
        tabs.setStyleSheet(
            f"QTabWidget::pane {{ border:1px solid {_BORDER}; background:{_SURFACE}; }}"
            f"QTabBar::tab {{ background:{_BG}; color:{_DIM}; padding:8px 16px; "
            f"font-family:'Courier New'; font-size:11px; "
            f"border:1px solid {_BORDER}; margin-right:2px; }}"
            f"QTabBar::tab:selected {{ background:{_SURFACE}; color:{_ORANGE}; "
            f"border-bottom:2px solid {_ORANGE}; }}"
            f"QTabBar::tab:hover {{ color:{_TEXT}; }}"
        )

        tabs.addTab(self._placeholder_tab("◈", "COLLECTION",
                                          "Your Starfield artefact collection.\n"
                                          "[Replace with your CollectionPanel widget]",
                                          _ORANGE),
                    "◈  COLLECTION")

        tabs.addTab(self._placeholder_tab("⟐", "OUTPOSTS",
                                          "Outpost management and base inventory.\n"
                                          "[Replace with your OutpostPanel widget]",
                                          _ORANGE),
                    "⟐  OUTPOSTS")

        if self._embed_mc:
            # ── Mission Controller embedded as "Image Vault" tab ─────────────
            mc = create_mc_widget(parent=tabs)
            tabs.addTab(mc, "⬡  IMAGE VAULT")

        return tabs

    # ── Panel 4: COMPANIONS ──────────────────────────────────────────────────
    def _build_companions_panel(self) -> QWidget:
        return self._placeholder_tab(
            "◇", "COMPANIONS",
            "Crew members · Relationship status · Assignment roster.\n"
            "[Replace with your CompanionsPanel widget]",
            _GREEN,
        )

    # ── Panel 5: COSMIC CHOICE ───────────────────────────────────────────────
    def _build_cosmic_choice_panel(self) -> QWidget:
        return self._placeholder_tab(
            "⟐", "COSMIC CHOICE",
            "New Game Plus decisions · Constellation path.\n"
            "[Replace with your CosmicChoiceDetailPanel widget]",
            _PURPLE,
        )

    # ── Reusable placeholder ─────────────────────────────────────────────────
    @staticmethod
    def _placeholder_tab(
        glyph: str,
        name: str,
        description: str,
        colour: str,
    ) -> QWidget:
        w = QWidget()
        w.setStyleSheet(f"background:{_BG};")
        v = QVBoxLayout(w)
        v.setAlignment(Qt.AlignmentFlag.AlignCenter)

        icon = QLabel(glyph)
        icon.setFont(QFont("Courier New", 56))
        icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        icon.setStyleSheet(f"color:{colour};")
        v.addWidget(icon)

        lbl = QLabel(name)
        lbl.setFont(QFont("Courier New", 18, QFont.Weight.Bold))
        lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lbl.setStyleSheet(f"color:{colour}; letter-spacing:5px;")
        v.addWidget(lbl)

        sep = QFrame()
        sep.setFrameShape(QFrame.Shape.HLine)
        sep.setStyleSheet(f"color:{_BORDER}; margin:12px 80px;")
        v.addWidget(sep)

        desc = QLabel(description)
        desc.setAlignment(Qt.AlignmentFlag.AlignCenter)
        desc.setWordWrap(True)
        desc.setStyleSheet(
            f"color:{_DIM}; font-size:11px; font-family:'Courier New';"
        )
        v.addWidget(desc)
        return w


