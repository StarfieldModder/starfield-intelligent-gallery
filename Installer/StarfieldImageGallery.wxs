<?xml version="1.0" encoding="UTF-8"?><!--  ================================================================  Starfield Image Gallery — Windows Installer Source (.wxs)  WiX Toolset v3.x  Generated: June 29, 2026  ================================================================  ASSETS EXPECTED in C:\SIG\Installer\ alongside this .wxs:    ✔  InstallerBanner.bmp   — Top banner   (493 x 58 px,  24-bit BMP)    ✔  InstallerDialog.bmp   — Welcome/Finish background (493 x 312 px, 24-bit BMP)    ✔  SIG.ico               — Application icon    ►  SIG.exe               — Main application executable    ►  License.rtf           — License agreement (required by WixUI_InstallDir)  BUILD COMMANDS (run from C:\SIG\Installer\):    candle.exe StarfieldImageGallery.wxs -ext WixUIExtension    light.exe  StarfieldImageGallery.wixobj -ext WixUIExtension -o StarfieldImageGallery.msi  ================================================================--><Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">  <Product Id="{D1F6311B-AFE3-4478-813C-F48C2D6AF031}"           Name="Starfield Image Gallery"           Language="1033"           Version="1.0.0.0"           Manufacturer="Games"           UpgradeCode="{BB609E80-4B5F-4099-8AAC-3DE49CCA8495}">    <Package InstallerVersion="301"             Compressed="yes"             InstallScope="perMachine"             Description="Starfield Image Gallery — Windows Installer"             Comments="Copyright © 2026 Games. All rights reserved." />    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />    <MediaTemplate EmbedCab="yes" />    <!-- ══════════════════════════════════════════════         PRODUCT ICON  (shows in Add/Remove Programs)         ══════════════════════════════════════════════ -->    <Icon Id="SIG.ico" SourceFile="SIG.ico" />    <Property Id="ARPPRODUCTICON"  Value="SIG.ico" />    <Property Id="ARPURLINFOABOUT" Value="https://github.com/latsha2025" />    <!-- ══════════════════════════════════════════════         FEATURES         ══════════════════════════════════════════════ -->    <Feature Id="ProductFeature"             Title="Starfield Image Gallery"             Description="Installs the Starfield Image Gallery application and your personal image collection."             Level="1">      <ComponentGroupRef Id="ProductComponents" />    </Feature>    <!-- ══════════════════════════════════════════════         INSTALLER UI         Welcome → License → Folder → Install → Finish         ══════════════════════════════════════════════ -->    <UIRef Id="WixUI_InstallDir" />    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />    <!-- YOUR personal artwork wired into the WiX dialogs -->    <WixVariable Id="WixUIBannerBmp"  Value="InstallerBanner.bmp" />    <WixVariable Id="WixUIDialogBmp"  Value="InstallerDialog.bmp" />    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />  </Product>  <!-- ══════════════════════════════════════════════════════════       DIRECTORY TREE       ══════════════════════════════════════════════════════════ -->  <Fragment>    <Directory Id="TARGETDIR" Name="SourceDir">      <!-- C:\Program Files\Starfield Image Gallery\ -->      <Directory Id="ProgramFilesFolder">        <Directory Id="INSTALLFOLDER" Name="Starfield Image Gallery">          <!-- C:\Program Files\Starfield Image Gallery\Images\ -->          <Directory Id="ImagesFolder" Name="Images" />        </Directory>      </Directory>      <!-- Start Menu → Programs → Starfield Image Gallery -->      <Directory Id="ProgramMenuFolder">        <Directory Id="ApplicationProgramsFolder" Name="Starfield Image Gallery" />      </Directory>      <!-- Desktop -->      <Directory Id="DesktopFolder" Name="Desktop" />    </Directory>  </Fragment>  <!-- ══════════════════════════════════════════════════════════       COMPONENTS       ══════════════════════════════════════════════════════════ -->  <Fragment>    <ComponentGroup Id="ProductComponents">      <!-- ─────────────────────────────────────────────────────           COMPONENT 1 — Main Executable (SIG.exe)           Creates Desktop + Start Menu shortcuts           ───────────────────────────────────────────────────── -->      <Component Id="CmpMainExe"                 Guid="{A19A6575-4263-484E-8A1C-39B93F754F3F}"                 Directory="INSTALLFOLDER">        <File Id="FILE_SIG_EXE"              Source="SIG.exe"              KeyPath="yes"              Checksum="yes">          <!-- Start Menu shortcut -->          <Shortcut Id="SC_StartMenu"                    Name="Starfield Image Gallery"                    Description="Browse and view your Starfield image collection"                    Directory="ApplicationProgramsFolder"                    WorkingDirectory="INSTALLFOLDER"                    Icon="SIG.ico"                    Advertise="yes" />          <!-- Desktop shortcut -->          <Shortcut Id="SC_Desktop"                    Name="Starfield Image Gallery"                    Description="Browse and view your Starfield image collection"                    Directory="DesktopFolder"                    WorkingDirectory="INSTALLFOLDER"                    Icon="SIG.ico"                    Advertise="yes" />        </File>      </Component>      <!-- ─────────────────────────────────────────────────────           COMPONENT 2 — Personal Images (UNCOMMENT + POPULATE)           Add one <File> element per image in your collection.           ─────────────────────────────────────────────────────      <Component Id="CmpImages"                 Guid="{5437A453-0B7E-43B3-9500-E3601810B7DC}"                 Directory="ImagesFolder">        <File Id="FILE_IMG_001" Source="Images\photo001.jpg" KeyPath="yes" />        <File Id="FILE_IMG_002" Source="Images\photo002.jpg" />        <File Id="FILE_IMG_003" Source="Images\photo003.png" />      </Component>           ───────────────────────────────────────────────────── -->      <!-- ─────────────────────────────────────────────────────           COMPONENT 3 — Start Menu folder + Uninstall shortcut           ───────────────────────────────────────────────────── -->      <Component Id="CmpStartMenuCleanup"                 Guid="{20A0BD94-4E40-4C2F-B329-AEFF0B83255B}"                 Directory="ApplicationProgramsFolder">        <Shortcut Id="SC_Uninstall"                  Name="Uninstall Starfield Image Gallery"                  Description="Remove Starfield Image Gallery from this computer"                  Target="[SystemFolder]msiexec.exe"                  Arguments="/x [ProductCode]"                  WorkingDirectory="INSTALLFOLDER" />        <RemoveFolder Id="RF_AppMenu"                      Directory="ApplicationProgramsFolder"                      On="uninstall" />        <RegistryValue Root="HKCU"                       Key="Software\Games\StarfieldImageGallery"                       Name="Installed"                       Type="integer"                       Value="1"                       KeyPath="yes" />      </Component>      <!-- ─────────────────────────────────────────────────────           COMPONENT 4 — Desktop shortcut cleanup on uninstall           ───────────────────────────────────────────────────── -->      <Component Id="CmpDesktopCleanup"                 Guid="{C9ED2058-8E0D-43EF-9CB4-48E15BF07CF7}"                 Directory="DesktopFolder">        <RemoveFolder Id="RF_Desktop"                      Directory="DesktopFolder"                      On="uninstall" />        <RegistryValue Root="HKCU"                       Key="Software\Games\StarfieldImageGallery"                       Name="DesktopShortcut"                       Type="integer"                       Value="1"                       KeyPath="yes" />      </Component>    </ComponentGroup>  </Fragment></Wix>